# --- Supabase ---
# Project Settings → Data API / API keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used only in trusted server code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional (Phase 3 — offline AI letter drafting). Server-only.
# ANTHROPIC_API_KEY=

# WhatsApp gateway (Fonnte) — sends the daily-rating summary to your partner.
# Get the token at https://fonnte.com after linking a WhatsApp device. Server-only.
# FONNTE_TOKEN=

# Little Things reminders. The app sends due WhatsApp reminders whenever either
# of you opens it; this secret additionally unlocks /api/cron/reminders so a
# scheduler (Vercel Cron, see vercel.json) can send them on the days nobody does.
# Leave it unset and that endpoint stays 404 — in-app reminders still work.
# CRON_SECRET=a-long-random-string
